# Security Graph configuration.
#
# Copy to .env and fill in the two secrets, or run scripts/quickstart.sh, which
# generates them. Every setting is an environment variable prefixed SECGRAPH_;
# anything left out keeps the default shown here. Nothing is fetched from the
# network at start-up.

# --- required for docker compose -------------------------------------------
# Use only letters and digits: the password is placed in a connection URL.
POSTGRES_PASSWORD=
# 32+ random characters. Signs the console's session tokens.
SECGRAPH_JWT_SECRET=

# --- service ----------------------------------------------------------------
# production refuses SQLite, a default JWT secret, a bootstrap password and CORS "*".
# SECGRAPH_ENVIRONMENT=production
# SECGRAPH_LOG_LEVEL=INFO
# SECGRAPH_LOG_JSON=true
# SECGRAPH_DOCS_ENABLED=true          # /docs and /redoc need a CDN; /openapi.json does not
# SECGRAPH_CORS_ORIGINS=              # comma-separated; empty = same-origin only
# SECGRAPH_METRICS_TOKEN=             # when set, /metrics requires "Authorization: Bearer <token>"
# SECGRAPH_BIND=127.0.0.1             # compose: host address the API is published on
# SECGRAPH_PORT=8080                  # compose: host port

# --- database (not needed with docker compose, which sets it) ----------------
# SECGRAPH_DATABASE_URL=postgresql+psycopg://secgraph:<password>@db-host:5432/secgraph
# SECGRAPH_DB_POOL_SIZE=10
# SECGRAPH_DB_MAX_OVERFLOW=20
# SECGRAPH_DB_STATEMENT_TIMEOUT_MS=30000
# SECGRAPH_AUTO_MIGRATE=false         # single-replica convenience; otherwise run `secgraph migrate`

# --- ontology and mappings ---------------------------------------------------
# SECGRAPH_ONTOLOGY_FILE=             # path to your own ontology; default is the packaged core
# SECGRAPH_MAPPINGS_DIR=              # directory of extra source mappings (*.yaml)
# SECGRAPH_SOURCE_PRIORITY=           # e.g. cmdb,edr,scanner — first wins a property conflict
# SECGRAPH_DEFAULT_TENANT=default

# --- sign-in -----------------------------------------------------------------
# SECGRAPH_JWT_TTL_SECONDS=3600
# SECGRAPH_LOGIN_MAX_FAILURES=5
# SECGRAPH_LOGIN_LOCKOUT_SECONDS=900
# Tokens from your own identity provider (Keycloak, ADFS, ...): RS256/ES256, verified offline.
# SECGRAPH_OIDC_PUBLIC_KEY_FILE=/etc/secgraph/idp.pem
# SECGRAPH_OIDC_ISSUER=https://idp.bank.example/realms/soc
# SECGRAPH_OIDC_AUDIENCE=security-graph
# SECGRAPH_OIDC_ROLES_CLAIM=roles
# SECGRAPH_OIDC_TENANT_CLAIM=tenant
# Development only (refused in production): creates user "admin" on first start.
# SECGRAPH_BOOTSTRAP_ADMIN_PASSWORD=

# --- governance --------------------------------------------------------------
# SECGRAPH_RATE_LIMIT_PER_MINUTE=600  # per credential, per API replica
# SECGRAPH_RATE_LIMIT_BURST=120
# Protective plane (AgentPEP / LLM Firewall / Thoth): everything that leaves for an agent,
# and everything an agent writes to memory, is sent here first.
# SECGRAPH_GUARDRAIL_WEBHOOK_URL=https://agentpep.bank.example/v1/check
# SECGRAPH_GUARDRAIL_FAIL_CLOSED=true
# SECGRAPH_GUARDRAIL_TIMEOUT_S=5

# --- limits ------------------------------------------------------------------
# SECGRAPH_INGEST_MAX_RECORDS=50000
# SECGRAPH_INGEST_MAX_BODY_BYTES=67108864
# SECGRAPH_QUERY_MAX_DEPTH=6
# SECGRAPH_QUERY_MAX_NODES=5000
# SECGRAPH_ANALYTICS_MAX_NODES=250000
# SECGRAPH_ANALYTICS_MAX_EDGES=2000000
# SECGRAPH_ANALYTICS_MC_SAMPLES=2000
# SECGRAPH_ANALYTICS_CACHE_TTL_SECONDS=300
# SECGRAPH_ANALYTICS_SEED=20260930

# --- change feed and webhooks -------------------------------------------------
# SECGRAPH_WEBHOOK_ALLOWED_HOSTS=     # comma-separated hostnames / CIDRs; empty = any non-blocked host
# SECGRAPH_WEBHOOK_ALLOW_PRIVATE=true
# SECGRAPH_WEBHOOK_MAX_ATTEMPTS=8
# SECGRAPH_CHANGE_RETENTION_DAYS=30
# SECGRAPH_HISTORY_RETENTION_DAYS=0   # 0 = keep entity and relationship history forever

# --- agents ------------------------------------------------------------------
# SECGRAPH_CONTEXT_DEFAULT_BUDGET_TOKENS=2000
# SECGRAPH_CONTEXT_MAX_BUDGET_TOKENS=16000
# SECGRAPH_MEMORY_MAX_BODY_CHARS=20000

# --- worker ------------------------------------------------------------------
# SECGRAPH_WORKER_INTERVAL_SECONDS=5
# SECGRAPH_MAINTENANCE_INTERVAL_SECONDS=3600
